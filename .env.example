# ---------------------------------------------------------------------------
# ArthaLab environment configuration — TEMPLATE
# ---------------------------------------------------------------------------
# 1. Copy this file to `.env`  (cp .env.example .env)
# 2. Fill in your real GEMINI_API_KEY.
# 3. NEVER commit `.env` — it is git-ignored on purpose.
#
# The application reads these at startup via python-dotenv. No key or model id
# is ever hard-coded in the source.
# ---------------------------------------------------------------------------

# REQUIRED — your Google Gemini API key.
# Get one (free tier available) at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# ---------------------------------------------------------------------------
# OPTIONAL — model selection. Leave commented to use the verified defaults
# (gemini-2.5-flash primary, gemini-2.5-pro fallback).
#
# The app tries the models left-to-right and returns the first that succeeds.
# If your account exposes newer ids (e.g. a gemini-3.x family), just list them
# here — NO code change is needed. Verify available ids for your key at:
#   https://ai.google.dev/gemini-api/docs/models
# ---------------------------------------------------------------------------

# Full fallback chain (highest priority; overrides the pair below if set):
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro

# …or set the pair individually:
# GEMINI_PRIMARY_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-pro

# OPTIONAL — generation temperature (0.0 = deterministic, 1.0 = creative).
# GEMINI_TEMPERATURE=0.4
